# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build
/dist

# typescript
*.tsbuildinfo
next-env.d.ts

# env files — real credentials live in .env.local and never get committed.
# The template is the one exception: it holds placeholders only.
.env*
!.env.example

# vercel
.vercel

# secrets / keys
*.pem
*.key
*.p12
*.pfx

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

# caches
.eslintcache
.turbo/
.cache/

# generated knowledge graph (rebuild with /graphify)
/graphify-out/

# Claude Code — per-machine settings stay local; shared launch config is tracked
/.claude/*
!/.claude/launch.json

# editors / OS
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~
