# TEMPLATE ONLY — nothing loads this file. Editing it has no effect.
# Copy it to .env.local and edit that; Next.js and the db:* scripts read
# .env.local. Both are gitignored (.env*) — never commit real credentials,
# and never paste them into a chat or an issue.

# ============================================================
# REQUIRED IN PRODUCTION
# ============================================================

# Signs session cookies. The app REFUSES TO BOOT in production without it —
# a deployment signing sessions with a default key has no sessions at all.
# Generate a fresh one per environment:
#     openssl rand -base64 32
# Rotating this signs everyone out, which is the intended emergency lever.
AUTH_SECRET=

# ============================================================
# DATABASE
# ============================================================

# ---- Local mongod (the default when MONGODB_URI is unset) ----
MONGODB_URI=mongodb://127.0.0.1:27017

# ---- MongoDB Atlas ----
# Replace <db_password> with the real password for the `ghorly` database user.
# If the password contains any of  : / ? # [ ] @  it must be percent-encoded.
# Atlas → Network Access must also allow the deploying host's IP.
#
# MONGODB_URI=mongodb+srv://ghorly:<db_password>@ghorly.krs1d4g.mongodb.net/?retryWrites=true&w=majority&appName=ghorly

MONGODB_DB=ghorly

# ============================================================
# OPTIONAL
# ============================================================

# ---- BulkSMSBD (bulksmsbd.net) ----
# REQUIRED IN PRODUCTION. While these are unset the app runs in development
# OTP mode: codes are logged server-side and returned in the login response,
# which means anyone could sign in as anyone. Production refuses to boot
# without them rather than shipping that.
#
# Both come from your BulkSMSBD panel. The sender ID must be approved by them.
# If it is a *masking* sender ID, the message must be Bengali — it already is
# (see lib/auth/sms/message.ts), which is why it stays that way.
#
# Verify before going live:  npm run sms:check
# Send one real test message: npm run sms:check 01XXXXXXXXX
# BULKSMSBD_API_KEY=
# BULKSMSBD_SENDER_ID=

# Base URL used by scripts/db-verify.ts.
# APP_URL=http://localhost:3000
